# ===========================================
# ROR Partnership Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# For Coolify: Add these as environment variables in the service settings

# ===========================================
# Server Configuration
# ===========================================
BUN_ENV=production
PORT=3000

# ===========================================
# Database Configuration
# ===========================================
# MongoDB connection string
# For Docker Compose: mongodb://mongo:27017/ror_partnership
# For external MongoDB: mongodb+srv://user:pass@cluster.mongodb.net/ror_partnership
MONGODB_URI=mongodb://mongo:27017/ror_partnership

# MongoDB root credentials (for Docker Compose only)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your-secure-password

# Redis connection string
# For Docker Compose: redis://redis:6379
REDIS_URL=redis://redis:6379

# ===========================================
# JWT Authentication
# ===========================================
# IMPORTANT: Generate a strong secret for production
# Use: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production-make-it-long-and-secure
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ===========================================
# API URLs
# ===========================================
# Public URL of the API (used for callbacks, emails, etc.)
API_URL=https://api.rorpartnership.com

# Frontend dashboard URL (for CORS)
APP_URL=https://dashboard.rorpartnership.com

# Mobile app deep link scheme
MOBILE_APP_SCHEME=rorpartnership

# ===========================================
# KingsChat OAuth Configuration
# ===========================================
# Client ID for KingsChat OAuth (public OAuth - no secret needed)
KINGCHAT_CLIENT_ID=com.kingschat

# Callback URL for KingsChat OAuth
# IMPORTANT: This MUST match your API_URL
# Format: {API_URL}/v1/auth/kingschat/callback
KINGCHAT_CALLBACK_URL=https://api.rorpartnership.com/v1/auth/kingschat/callback

# KingsChat API URL for profile fetching
KINGCHAT_API_URL=https://connect.kingsch.at/api/profile

# ===========================================
# Payment Gateway: Paystack
# ===========================================
# Get keys from https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=sk_live_xxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxx

# ===========================================
# Payment Gateway: Stripe
# ===========================================
# Get keys from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ===========================================
# Payment Gateway: Espees
# ===========================================
ESPEES_API_URL=https://api.espees.com
ESPEES_MERCHANT_ID=
ESPEES_API_KEY=

# ===========================================
# Email Configuration (optional)
# ===========================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@rorpartnership.com

# ===========================================
# Push Notifications (optional)
# ===========================================
# EXPO_ACCESS_TOKEN=
# FCM_SERVER_KEY=
