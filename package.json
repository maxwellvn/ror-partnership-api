{
  "name": "@ror/api",
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "seed": "bun run src/scripts/seed.ts"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "mongoose": "^8.8.0",
    "ioredis": "^5.4.0",
    "zod": "^3.23.0",
    "jsonwebtoken": "^9.0.0",
    "bcrypt": "^5.1.0",
    "nanoid": "^5.0.0",
    "nodemailer": "^6.9.0",
    "stripe": "^17.4.0",
    "@ror/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/nodemailer": "^6.4.0"
  }
}
